# Resend Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=contact@quranacademee.com
ADMIN_EMAIL=contact@quranacademee.com

# Google Authentication: Google Service Account
# (Standard production approach, automatically generates OAuth access tokens)
GOOGLE_PROJECT_ID=quranacademee
GOOGLE_CLIENT_EMAIL=your_service_account_email_here
# For multiline Google Private Key, paste it with newline escape sequences (\n) intact:
# e.g., GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgk...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=your_private_key_here
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Upstash Redis Configuration (Optional, for Serverless-reliable Rate Limiting on Vercel)
# If empty, the app gracefully falls back to memory rate limiting in local development.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
